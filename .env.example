# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
POSTGRES_DB=pollen
POSTGRES_USER=pollen
POSTGRES_PASSWORD=change_me

# --- Copernicus Atmosphere Data Store -------------------------------------
# https://ads.atmosphere.copernicus.eu/how-to-api
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=your-api-key

# --- Serving --------------------------------------------------------------
# Local: ":80" with the ports below.
#
# Caddy runs in the host network namespace (so it sees real client IPs), so
# SITE_ADDRESS is what decides the listening port -- there is no ports: mapping.
#
# Production: list every name to serve, comma separated. Caddy obtains and
# renews a certificate for each, so both must resolve to this host and port 80
# must be reachable for the ACME challenge. Bare names mean 80/443, which under
# rootless podman needs net.ipv4.ip_unprivileged_port_start=80.
#   SITE_ADDRESS=pollencast.eu, www.pollencast.eu
#   APEX_HOST=pollencast.eu
#   WWW_HOST=www.pollencast.eu
#   HTTP_PORT=80          # only used to build local check URLs
#
# APEX_HOST/WWW_HOST drive the apex -> www redirect. Leave them unset locally.
SITE_ADDRESS=:8080
HTTP_PORT=8080
APEX_HOST=
WWW_HOST=

# --- Optional -------------------------------------------------------------
# Ping URL for healthchecks.io or similar; the pipeline hits it on success.
HEALTHCHECK_URL=
BRONZE_RETENTION_DAYS=7
MAX_FORECAST_AGE_HOURS=36
LOG_LEVEL=INFO

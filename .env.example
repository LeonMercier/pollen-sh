# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
POSTGRES_DB=pollen
POSTGRES_USER=pollen
POSTGRES_PASSWORD=change_me

# --- Copernicus Atmosphere Data Store -------------------------------------
# https://ads.atmosphere.copernicus.eu/how-to-api
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=your-api-key

# --- Serving --------------------------------------------------------------
# Local: ":80" with the ports below. Production: the bare domain, e.g.
# SITE_ADDRESS=pollencast.eu -- Caddy then handles TLS automatically.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Optional -------------------------------------------------------------
# Ping URL for healthchecks.io or similar; the pipeline hits it on success.
HEALTHCHECK_URL=
BRONZE_RETENTION_DAYS=7
MAX_FORECAST_AGE_HOURS=36
LOG_LEVEL=INFO
